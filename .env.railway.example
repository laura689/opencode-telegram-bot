# Variables Railway pour le bot Telegram Nouvelle Lune.
# À copier dans Railway dashboard > Variables. Ne JAMAIS commit ce fichier rempli.

# === Telegram ===
# Token donné par @BotFather (format 1234567890:ABC...)
TELEGRAM_BOT_TOKEN=

# user_id Telegram de Laura (donné par @userinfobot, entier sans guillemets)
TELEGRAM_ALLOWED_USER_ID=

# === Vault GitHub ===
# Repo au format owner/name
VAULT_REPO=laura689/nouvelle-lune

# PAT GitHub (scope: contents read/write sur le repo nouvelle-lune)
# Génère sur github.com/settings/tokens?type=beta — Fine-grained token, expiration 1 an
VAULT_GITHUB_TOKEN=

# Chemin du clone vault dans le container (sur volume persistant)
VAULT_DIR=/data/vault

# Identité git pour les commits du bot
GIT_AUTHOR_EMAIL=bot@nouvellelune.co
GIT_AUTHOR_NAME=NL Cofounder Bot

# === OpenCode ===
# Provider et modèle par défaut. DeepSeek = ZDR Europe, ~100x moins cher.
# Options : opencode/big-pickle, anthropic/claude-sonnet-4-6, anthropic/claude-opus-4-7,
#           deepseek/deepseek-v4-flash, openrouter/...
OPENCODE_MODEL_PROVIDER=anthropic
OPENCODE_MODEL_ID=claude-sonnet-4-6

# URL OpenCode (loopback car même container)
OPENCODE_API_URL=http://127.0.0.1:4096

# Clés API providers — au moins une obligatoire selon le modèle choisi
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Persistance OpenCode sur volume
OPENCODE_DATA_DIR=/data/opencode

# === Whisper (Speech-to-Text) ===
# OpenAI-compatible. OpenAI direct ou Groq (moins cher, plus rapide).
STT_API_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=fr

# === Bot config ===
# Locale française
BOT_LOCALE=fr

# Whitelist filesystem pour les commandes /open et /ls
OPEN_BROWSER_ROOTS=/data/vault

# AppHome du bot (settings.json, logs) sur volume
OPENCODE_TELEGRAM_HOME=/data/appHome

# Dossier temporaire (audio, images téléchargées) — override pour Railway
BOT_TEMP_DIR=/tmp/opencode-telegram-bot

# Logging
LOG_LEVEL=info
LOG_RETENTION=10
NODE_ENV=production
